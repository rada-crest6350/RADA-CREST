{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin-referrals",
      "destination": "/admin-referrals.html"
    },
    {
      "source": "/admin-referral",
      "destination": "/admin-referral.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
